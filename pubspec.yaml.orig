name: bushort
description: "BUSHORT - Premium global short-form video social platform"
publish_to: 'none'

version: 1.0.0+1

environment:
  sdk: '>=3.1.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter
  
  # State Management & Architecture
  provider: ^6.0.0
  riverpod: ^2.4.0
  riverpod_generator: ^2.3.0
  
  # Navigation
  go_router: ^13.0.0
  
  # API & HTTP
  dio: ^5.3.0
  retrofit: ^4.0.0
  retrofit_generator: ^8.0.0
  
  # Local Storage & Database
  hive: ^2.2.0
  hive_flutter: ^1.1.0
  shared_preferences: ^2.2.0
  
  # Video & Media
  video_player: ^2.8.0
  chewie: ^1.7.0
  image_picker: ^1.0.0
  video_compress: ^3.2.0
  
  # Audio & Voice
  record: ^4.4.0
  audio_waveforms: ^1.0.0
  just_audio: ^0.9.0
  
  # Firebase (Optional - can replace with custom backend)
  firebase_core: ^2.24.0
  firebase_auth: ^4.15.0
  firebase_storage: ^11.5.0
  cloud_firestore: ^4.14.0
  firebase_messaging: ^14.7.0
  
  # UI & Design
  flutter_screenutil: ^5.9.0
  google_fonts: ^6.1.0
  flutter_svg: ^2.0.0
  lottie: ^2.7.0
  
  # Camera
  camera: ^0.10.5
  
  # Permission Handling
  permission_handler: ^11.4.0
  
  # Networking & Real-time
  socket_io_client: ^2.0.0
  
  # Security
  flutter_secure_storage: ^9.0.0
  crypto: ^3.0.0
  
  # Utils
  intl: ^0.19.0
  uuid: ^4.0.0
  get_it: ^7.6.0
  logger: ^2.1.0
  flutter_dotenv: ^5.1.0
  
  # Animation
  flutter_animate: ^4.2.0
  
  # Haptics
  vibration: ^1.9.0
  
dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^3.0.0
  build_runner: ^2.4.0
  hive_generator: ^2.0.0
  retrofit_generator: ^8.0.0
  riverpod_generator: ^2.3.0

flutter:
  uses-material-design: true
  
  assets:
    - assets/images/
    - assets/icons/
    - assets/animations/
    - assets/videos/
    - .env
  
  fonts:
    - family: Poppins
      fonts:
        - asset: assets/fonts/Poppins-Regular.ttf
        - asset: assets/fonts/Poppins-Bold.ttf
          weight: 700
        - asset: assets/fonts/Poppins-SemiBold.ttf
          weight: 600
        - asset: assets/fonts/Poppins-Medium.ttf
          weight: 500
