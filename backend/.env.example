# Database
DATABASE_URL=postgresql://Bushortdb_owner:npg_IszR6HJ8bpmv@ep-plain-wind-b1mu7d6l-pooler.c-5.eu-central-1.aws.neon.tech/Bushortdb?sslmode=require&channel_binding=require

# Server
PORT=3000
NODE_ENV=production

# JWT
JWT_SECRET=your_super_secure_jwt_secret_key_change_this_in_production
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_change_this
JWT_REFRESH_EXPIRY=30d

# AWS S3 (for video storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=bushort-videos

# File Upload
MAX_FILE_SIZE=104857600
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/x-msvideo

# Email (for verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Redis (for caching & real-time)
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:3001,https://bushort.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
